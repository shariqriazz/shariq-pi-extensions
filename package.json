{
  "name": "shariq-pi-extensions",
  "version": "0.2.21",
  "description": "Cross-platform extension suite for the Pi coding agent.",
  "license": "MIT",
  "author": "Shariq Riaz",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shariqriazz/shariq-pi-extensions.git"
  },
  "homepage": "https://github.com/shariqriazz/shariq-pi-extensions#readme",
  "bugs": {
    "url": "https://github.com/shariqriazz/shariq-pi-extensions/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "!extensions/subagents/test-support",
    "skills",
    "themes",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/antigravity-provider/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/context-usage/index.ts",
      "./extensions/copy-all/index.ts",
      "./extensions/cursor-provider/index.ts",
      "./extensions/factory-provider/index.ts",
      "./extensions/firecrawl-web/index.ts",
      "./extensions/git-info/index.ts",
      "./extensions/goal/index.ts",
      "./extensions/input-mode/index.ts",
      "./extensions/orchestration/index.ts",
      "./extensions/performance-status/index.ts",
      "./extensions/pi-memory/index.ts",
      "./extensions/shell-shortcuts/index.ts",
      "./extensions/smart-compaction/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/web-fetch/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/orchestration",
      "./skills/subagents"
    ],
    "themes": [
      "./themes/ember-warm-dark.json"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "validate:package": "npm run prepack && node scripts/validate-package.mjs",
    "validate": "npm run check && npm test && npm run validate:package",
    "pack:inspect": "npm pack --dry-run",
    "prepack": "node scripts/prepare-cursor-sdk-bundle.mjs",
    "prepublishOnly": "npm run validate"
  },
  "dependencies": {
    "@cursor/sdk": "1.0.28",
    "@lydell/node-pty": "1.1.0",
    "effect": "4.0.0-beta.98",
    "ws": "8.21.3"
  },
  "optionalDependencies": {
    "@cursor/sdk-darwin-arm64": "1.0.28",
    "@cursor/sdk-darwin-x64": "1.0.28",
    "@cursor/sdk-linux-arm64": "1.0.28",
    "@cursor/sdk-linux-x64": "1.0.28",
    "@cursor/sdk-win32-x64": "1.0.28"
  },
  "bundledDependencies": [
    "@cursor/sdk"
  ],
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.1.2",
    "@types/ws": "8.18.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false,
    "msgpackr-extract": false
  },
  "overrides": {
    "undici": "6.28.0"
  }
}
