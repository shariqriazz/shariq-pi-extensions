{
  "name": "pi-power-pack",
  "version": "0.11.0",
  "description": "Subagents, background terminals, smart compaction, goals, a task list, ask_user, image, video, and audio understanding, WebP images, and web search for the Pi coding agent. Formerly shariq-pi-extensions.",
  "license": "MIT",
  "author": "Shariq Riaz",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "pi",
    "coding-agent",
    "ai-agent",
    "subagents",
    "background-terminal",
    "context-compaction",
    "compaction",
    "goals",
    "task-list",
    "ask-user",
    "vision",
    "video-understanding",
    "audio-transcription",
    "webp",
    "web-search",
    "web-fetch",
    "firecrawl",
    "shariq-pi-extensions"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shariqriazz/pi-power-pack.git"
  },
  "homepage": "https://github.com/shariqriazz/pi-power-pack#readme",
  "bugs": {
    "url": "https://github.com/shariqriazz/pi-power-pack/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "!extensions/subagents/test-support",
    "skills",
    "themes",
    "docs",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/context-usage/index.ts",
      "./extensions/firecrawl-web/index.ts",
      "./extensions/goal/index.ts",
      "./extensions/input-mode/index.ts",
      "./extensions/media-understanding/index.ts",
      "./extensions/performance-status/index.ts",
      "./extensions/shell-shortcuts/index.ts",
      "./extensions/smart-compaction/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/task-list/index.ts",
      "./extensions/web-fetch/index.ts",
      "./extensions/webp-images/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/fusion",
      "./skills/subagents"
    ],
    "themes": [
      "./themes/ember-warm-dark.json"
    ],
    "changelogPath": "./docs/CHANGELOG.md"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate": "bun run check && bun fmt --check && node scripts/run-tests.mjs && bun run validate:package",
    "pack:inspect": "npm pack --dry-run",
    "prepublishOnly": "bun run validate"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.1.0",
    "effect": "4.0.0",
    "node-html-markdown": "^2.0.0",
    "node-html-parser": "^6.1.13",
    "sharp": "^0.35.5"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.4.0",
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@earendil-works/pi-tui": "^1.4.0",
    "@types/node": "^26.6.4",
    "typebox": "^1.3.34",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false,
    "msgpackr-extract": false
  }
}
