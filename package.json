{
  "name": "shariq-pi-extensions",
  "version": "0.1.0",
  "private": true,
  "description": "Private cross-platform extension suite for the Pi coding agent.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shariqriazz/shariq-pi-extensions.git"
  },
  "files": [
    "extensions",
    "!extensions/**/*.test.ts",
    "!extensions/subagents/test-support",
    "skills",
    "themes",
    "docs",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/antigravity-provider/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/background-terminals/index.ts",
      "./extensions/context-usage/index.ts",
      "./extensions/copy-all/index.ts",
      "./extensions/factory-provider/index.ts",
      "./extensions/firecrawl-web/index.ts",
      "./extensions/git-info/index.ts",
      "./extensions/goal/index.ts",
      "./extensions/orchestration/index.ts",
      "./extensions/performance-status/index.ts",
      "./extensions/pi-memory/index.ts",
      "./extensions/shell-shortcuts/index.ts",
      "./extensions/subagents/index.ts",
      "./extensions/web-fetch/index.ts"
    ],
    "skills": [
      "./skills/background-terminals",
      "./skills/orchestration",
      "./skills/subagents"
    ],
    "themes": [
      "./themes/ember-warm-dark.json"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/run-tests.mjs",
    "validate:package": "node scripts/validate-package.mjs",
    "validate": "npm run check && npm test && npm run validate:package",
    "pack:inspect": "npm pack --dry-run"
  },
  "dependencies": {
    "@lydell/node-pty": "1.1.0",
    "effect": "4.0.0-beta.98",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@earendil-works/pi-tui": "0.84.2",
    "@types/node": "^26.1.2",
    "@types/ws": "8.18.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "@google/genai": false,
    "protobufjs": false,
    "msgpackr-extract": false
  }
}
