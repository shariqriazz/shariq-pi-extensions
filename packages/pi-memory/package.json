{
  "name": "@shariqriazz/pi-memory",
  "version": "0.1.0",
  "description": "Optional persistent memory extension for the Pi coding agent.",
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "memory"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shariqriazz/shariq-pi-extensions.git",
    "directory": "packages/pi-memory"
  },
  "publishConfig": {
    "access": "restricted"
  },
  "files": [
    "extensions/pi-memory/index.ts",
    "extensions/pi-memory/src",
    "extensions/pi-memory/README.md",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/pi-memory/index.ts"
    ]
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types extensions/pi-memory/test/*.test.ts",
    "validate": "npm run check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@types/node": "^26.1.2",
    "typebox": "1.3.7",
    "typescript": "^7.0.2"
  }
}
